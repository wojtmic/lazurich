import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct InstanceRow {
    id: string,
    name: string,
    version: string,
}

export component InstanceList inherits Rectangle {
    in property <[InstanceRow]> instances: [];
    callback launch(string);
    callback edit(string);

    background: Theme.background;

    ListView {
        width: 100%;
        height: 100%;

        for row in root.instances: Rectangle {
            height: 68px;
            width: 90%;
            x: (parent.width - self.width) / 2;
            background: transparent;

            entry := Rectangle {
                y: 4px;
                height: 60px;
                width: parent.width;
                background: entry-area.has-hover ? Theme.button.brighter(0.2) : Theme.button;
                border-radius: 8px;
                animate background { duration: 100ms; }

                entry-area := TouchArea {
                    clicked => { root.edit(row.id); }
                }

                VerticalLayout {
                    padding-left: 12px;
                    alignment: center;

                    Text {
                        text: row.name;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    Text {
                        text: row.version;
                        color: Theme.text.with-alpha(0.6);
                        font-size: 11px;
                    }
                }
            }
        }
    }
}