import { Theme } from "../theme.slint";

export struct ProgressStage {
    text: string,
    done: bool,
    active: bool,
}

export component ProgressOverlay inherits Rectangle {
    in property <bool> active: false;
    in property <float> progress: 0.0;
    in property <string> current-stage: "";
    in property <[ProgressStage]> stages: [];

    property <float> stripe-offset: 0;
    property <angle> spin-angle: 0deg;

    visible: self.opacity > 0.0;
    background: #000000aa;
    opacity: root.active ? 1.0 : 0.0;
    animate opacity {
        duration: 200ms;
        easing: ease-in-out;
    }

    Timer {
        interval: 16ms;
        running: root.active;
        triggered => { root.spin-angle += 6deg; }
    }

    Timer {
        interval: 16ms;
        running: root.active;
        triggered => { root.stripe-offset = mod(root.stripe-offset + 0.3, 16); }
    }

    // block clicks
    TouchArea {}

    Rectangle {
        width: min(720px, parent.width * 0.8);
        height: card-layout.preferred-height + 48px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.background;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.secondary;

        card-layout := VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: root.current-stage;
                color: Theme.text;
                font-size: 16px;
                font-weight: 600;
                horizontal-alignment: center;
                overflow: elide;
            }

            Rectangle {
                height: 8px;
                border-radius: 4px;
                background: Theme.secondary;
                clip: true;

                fill-bar := Rectangle {
                    x: 0;
                    width: parent.width * max(0.0, min(1.0, root.progress));
                    height: parent.height;
                    border-radius: 4px;
                    background: Theme.primary;
                    animate width { duration: 150ms; }

                    clip-mask := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        clip: true;

                        property <int> stripe-count: (fill-bar.width / 16px) + 3;

                        for i in clip-mask.stripe-count: Path {
                            width: 100%;
                            height: 100%;
                            fill: Theme.primary.darker(0.35);
                            viewbox-width: fill-bar.width / 1px;
                            viewbox-height: 8;
                            property <float> base-x: i * 16 - 48 + mod(root.stripe-offset, 16);
                            MoveTo { x: base-x; y: 8; }
                            LineTo { x: base-x + 4; y: 8; }
                            LineTo { x: base-x + 10; y: 0; }
                            LineTo { x: base-x + 6; y: 0; }
                            Close {}
                        }
                    }
                }
            }

            Text {
                text: @tr("{}%", round(root.progress * 100));
                color: Theme.text.with-alpha(0.6);
                font-size: 11px;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 1px;
                background: Theme.secondary;
            }

            VerticalLayout {
                spacing: 8px;
                for stage[i] in root.stages: HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        y: (parent.height - self.height) / 2;

                        if !stage.active: Rectangle {
                            border-radius: 4px;
                            background: stage.done ? Theme.primary : Theme.secondary;
                        }

                        if stage.active: Rectangle {
                            border-radius: 4px;
                            border-width: 1.5px;
                            border-color: Theme.secondary;
                            background: transparent;

                            orbit-dot := Rectangle {
                                width: 3px;
                                height: 3px;
                                border-radius: 1.5px;
                                background: Theme.primary;
                                property <length> radius: parent.width / 2 - self.width / 2;
                                x: parent.width / 2 - self.width / 2 + self.radius * cos(root.spin-angle);
                                y: parent.height / 2 - self.height / 2 + self.radius * sin(root.spin-angle);
                            }
                        }
                    }
                    Text {
                        text: stage.text;
                        color: stage.done ? Theme.text : Theme.text.with-alpha(0.45);
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}